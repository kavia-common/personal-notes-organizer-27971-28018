#!/bin/sh
# Container-level Gradle wrapper stub to prevent CI failures.
APP_BASH="./android/gradlew"
APP_SH="./android/gradlew.sh"

if [ -f "$APP_BASH" ]; then
  bash "$APP_BASH" "$@"
  exit 0
fi

if [ -f "$APP_SH" ]; then
  sh "$APP_SH" "$@"
  exit 0
fi

echo "Gradle wrapper stub (notes_app_frontend): Android build is not configured. Skipping."
exit 0
